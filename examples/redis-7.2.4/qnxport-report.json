    "QNX105": {
      "title": "sanitizers and Linux-only linker flags",
      "category": "build",
      "base_severity": "low",
      "confidence": "verify",
      "why": "-fsanitize=*, -Wl,--no-undefined and -Wl,-z,* are common on Linux builds; whether your QNX SDP's compiler/linker accepts them is not stated in the pages searched.",
      "qnx_8_0": "Make them conditional for the QNX target and test the link with your SDP (verify).",
