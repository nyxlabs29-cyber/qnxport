    "QNX007": {
      "title": "prctl()",
      "category": "process",
      "base_severity": "high",
      "confidence": "verify",
      "why": "prctl has no page in the QNX 8.0 C Library Reference.",
      "qnx_8_0": "PR_SET_NAME / PR_GET_NAME map to pthread_setname_np(0, name) / pthread_getname_np() (documented; the length limit is _NTO_THREAD_NAME_MAX instead of Linux's 16 bytes). Other options (PR_SET_PDEATHSIG, PR_SET_DUMPABLE, PR_SET_NO_NEW_PRIVS, PR_SET_SECCOMP ...) have no documented single-call equivalent: verify, or use procmgr_ability() for privilege control.",
      "docs": [
        {
